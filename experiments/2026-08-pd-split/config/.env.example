# GGUF を置いているディレクトリの絶対パス(必須)
MODEL_DIR=/home/YOUR_USER/models/gguf

# 使用する GGUF ファイル名
MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf

# llama.cpp のタグ。Decode 側と必ず一致させる
LLAMA_TAG=b10679

# GPU の compute capability。RTX 4080 SUPER は 89
CUDA_ARCH=89

# ベースイメージの CUDA バージョン
CUDA_VERSION=12.8.1

# 公開ポート(既存の llama-swap 11435 / ccshim 11436-11438 と衝突しない値)
PD_SERVER_PORT=18080
PD_KV_PORT=18081

# コンテキスト長と KV キャッシュ量子化。Decode 側と必ず一致させる
PD_N_CTX=16384
PD_KV_TYPE=q8_0
