# 認証ゲートの実トークン
deploy/auth-gate/.env

# llama-swap のローカル設定(HF_TOKEN / ポート)
deploy/llama-swap/.env

# PrismML 版 llama.cpp のバイナリ(config.yaml の bonsai2-27b が参照。手動配置、約 200 MB)
deploy/llama-swap/prism/

# PD分離 PoC のローカル設定と KV キャッシュ実体
experiments/2026-08-pd-split/config/.env
experiments/2026-08-pd-split/config/kv/*
!experiments/2026-08-pd-split/config/kv/.gitkeep

# 実験の生ログ・生出力。集計済みの csv / jsonl / md だけを results/ 直下に commit する
experiments/*/results/raw/

# prettier 中間生成物
.ai-out/

# Python バイトコード・仮想環境
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# 階層型 KV キャッシュ計測のローカル設定と KV ダンプ
experiments/2026-09-kv-tier/config/.env
experiments/2026-09-kv-tier/config/kv/*.bin

# SearXNG の秘密鍵入り設定(example から生成する)
deploy/webui/searxng/settings.yml

# superpowers の作業用スクラッチ(台帳・レビュー資料)
.superpowers/

# 投機デコード計測のローカル設定と、Claude Code の system prompt を含む抽出プロンプト
experiments/2026-10-speculative-decoding/config/.env
experiments/2026-10-speculative-decoding/scripts/data/private/

# 電力リミット実験の生ログ
experiments/2026-10-power-limit/results/raw/
